{
  "name": "adaptive-runtime",
  "version": "0.9.0",
  "description": "Deterministic, zero-dependency adaptive execution runtime for TypeScript across Node.js, browsers, and edge/WinterCG runtimes — orchestrating algorithmic strategies via explicit resource signals, budgets, and hysteresis policies.",
  "license": "Apache-2.0",
  "author": "The Adaptive Runtime Contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yusufgulerr/adaptive-runtime.git"
  },
  "homepage": "https://github.com/yusufgulerr/adaptive-runtime#readme",
  "bugs": {
    "url": "https://github.com/yusufgulerr/adaptive-runtime/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "import": "./dist/web.js",
      "default": "./dist/web.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./policy": {
      "types": "./dist/policy/index.d.ts",
      "import": "./dist/policy/index.js",
      "default": "./dist/policy/index.js"
    },
    "./providers": {
      "types": "./dist/providers/index.d.ts",
      "import": "./dist/providers/index.js",
      "default": "./dist/providers/index.js"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "default": "./dist/observability/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js",
      "default": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "adaptive-runtime",
    "resource-management",
    "policy-engine",
    "graceful-degradation",
    "load-shedding",
    "hysteresis",
    "resilience",
    "quality-of-service",
    "observability",
    "opentelemetry",
    "prometheus",
    "edge-computing",
    "web",
    "wintercg",
    "testing",
    "performance",
    "typescript",
    "nodejs",
    "zero-dependencies"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "biome check src tests examples benchmarks scripts",
    "format": "biome check --write src tests examples benchmarks scripts",
    "test": "node --import tsx --test \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\" \"tests/property/*.test.ts\" \"tests/e2e/*.test.ts\"",
    "test:e2e": "node --import tsx --test \"tests/e2e/*.test.ts\"",
    "test:fuzz": "node --import tsx --test \"tests/property/*.test.ts\"",
    "test:coverage": "node --import tsx --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test \"tests/unit/*.test.ts\" \"tests/integration/*.test.ts\" \"tests/property/*.test.ts\" \"tests/e2e/*.test.ts\"",
    "example:basic": "tsx examples/basic/index.ts",
    "example:search": "tsx examples/resource-aware-search/index.ts",
    "example:planning": "tsx examples/resource-pressure-planning/index.ts",
    "example:quick-start": "tsx examples/quick-start/quick-start.ts",
    "example:observability": "tsx examples/observability/index.ts",
    "example:edge": "tsx examples/multi-runtime-edge/index.ts",
    "benchmark": "node --expose-gc --import tsx benchmarks/runtime-overhead.ts",
    "benchmark:concurrency": "node --expose-gc --import tsx benchmarks/concurrency.ts",
    "benchmark:compare": "node scripts/compare-benchmarks.mjs",
    "verify:exports": "node scripts/verify-package-exports.mjs",
    "verify:publish": "node scripts/verify-published-package.mjs",
    "verify:version-sync": "node scripts/verify-version-sync.mjs",
    "verify:zero-deps": "node scripts/verify-zero-dependencies.mjs",
    "check:links": "node scripts/check-markdown-links.mjs",
    "check": "npm run lint && npm run typecheck && npm run verify:version-sync && npm test && npm run build && npm run verify:exports && npm run verify:zero-deps && npm run check:links",
    "prepack": "npm run build",
    "prepublishOnly": "npm run check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "tsx": "^4.20.0",
    "typescript": "^7.0.2"
  }
}
